generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OWNER
  PROFESSIONAL
  CLIENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  FINISHED
  CANCELED
  NO_SHOW
}

enum AppointmentProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum AppointmentMessageSender {
  OWNER
  CLIENT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

enum CompanyStatus {
  PENDING
  PAYMENT_PENDING
  UNDER_REVIEW
  ACTIVE
  BLOCKED
  SUSPENDED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
  CANCELED
  REFUNDED
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?
  profileImageUrl String?
  passwordHash    String
  role            UserRole @default(OWNER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businesses         Business[] @relation("BusinessOwner")
  approvedBusinesses Business[] @relation("BusinessApprover")
  clientProfiles     Client[]   @relation("ClientUser")
  auditLogs          AuditLog[] @relation("AuditActor")

  @@map("users")
}

enum BusinessSegment {
  BARBERSHOP
  BEAUTY
  ODONTOLOGY
  VETERINARY
  WELLNESS
  OTHER
}

enum BusinessSpecialty {
  BEAUTY_GENERAL
  HAIR
  NAILS
  LASHES
  MAKEUP
  SKINCARE
  EYEBROWS
}

model Business {
  id           String        @id @default(uuid())
  ownerId      String
  approvedById String?
  name         String
  phone        String?
  email        String?
  address      String?
  category     String?
  logoUrl      String?
  slug         String        @unique
  status       CompanyStatus @default(PENDING)
  statusReason String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner         User           @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  approvedBy    User?          @relation("BusinessApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  clients       Client[]
  services      Service[]
  professionals Professional[]
  appointments  Appointment[]
  subscription  Subscription?
  payments      Payment[]
  auditLogs     AuditLog[]

  segment   BusinessSegment?
  specialty BusinessSpecialty?

  @@index([status])
  @@index([approvedById])
  @@map("businesses")
}

model Client {
  id         String    @id @default(uuid())
  businessId String
  userId     String?
  name       String
  phone      String?
  email      String?
  birthDate  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation("ClientUser", fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([userId])
  @@map("clients")
}

model Service {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  category        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

model Professional {
  id         String   @id @default(uuid())
  businessId String
  name       String
  phone      String?
  email      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("professionals")
}

model Appointment {
  id             String            @id @default(uuid())
  businessId     String
  clientId       String
  professionalId String
  serviceId      String
  date           DateTime
  startTime      String
  endTime        String
  status         AppointmentStatus @default(SCHEDULED)
  price          Decimal           @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional          @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  proposals    AppointmentProposal[]
  messages     AppointmentMessage[]

  @@map("appointments")
}

model AppointmentProposal {
  id                 String                    @id @default(uuid())
  appointmentId      String
  suggestedDate      DateTime
  suggestedStartTime String
  suggestedEndTime   String
  message            String?
  status             AppointmentProposalStatus @default(PENDING)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_proposals")
}

model AppointmentMessage {
  id            String                   @id @default(uuid())
  appointmentId String
  sender        AppointmentMessageSender
  message       String
  createdAt     DateTime                 @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_messages")
}

model Subscription {
  id                String             @id @default(uuid())
  businessId        String             @unique
  plan              SubscriptionPlan   @default(PRO)
  cycle             BillingCycle       @default(MONTHLY)
  installments      Int                @default(1)
  installmentAmount Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal            @default(0) @db.Decimal(10, 2)
  status            SubscriptionStatus @default(PENDING)
  startedAt         DateTime           @default(now())
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(uuid())
  businessId        String
  subscriptionId    String?
  provider          String
  providerPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  dueAt             DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([status, dueAt])
  @@index([subscriptionId])
  @@map("payments")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  businessId   String?
  action       String
  entityType   String
  entityId     String?
  reason       String?
  previousData Json?
  newData      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  actor    User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([businessId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformPaymentOption {
  id           String       @id @default(uuid())
  cycle        BillingCycle @unique
  paymentLink  String?
  pixCopyPaste String?
  pixQrCodeUrl String?
  instructions String?
  active       Boolean      @default(true)
  updatedById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("platform_payment_options")
}
